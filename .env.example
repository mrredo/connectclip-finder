# ==============================================================
# ConnectClip Finder Configuration
# ==============================================================

# Scan Interval (e.g. 15m, 30m, 1h)
SCAN_INTERVAL=30m

# Minimum matching score (0-100) required to trigger a notification
MIN_ALERT_SCORE=70

# SQLite database file path
DB_PATH=data/connectclip.db

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# --------------------------------------------------------------
# Target Product / Search Configuration
# --------------------------------------------------------------
# You can monitor ANY item (e.g. phones, bikes, tools, consoles, lost accessories).
# Defaults to Oticon ConnectClip if left blank.

TARGET_NAME=Oticon ConnectClip

# Comma-separated search queries submitted to marketplace search bars
SEARCH_TERMS=Oticon ConnectClip, ConnectClip, Connect Clip, Oticon dzirdes, Oticon mikrofons, Oticon Bluetooth, Oticon streamer, 178509

# Target price range (gives bonus score if price falls within range)
TARGET_MIN_PRICE=30
TARGET_MAX_PRICE=200

# Optional custom matching rules (leave empty to use default Oticon rules):
# MATCH_EXACT_KEYWORDS=Oticon ConnectClip, Connect Clip
# MATCH_CONTEXT_KEYWORDS=mikrofons, dzirdes aparats, streamer
# MATCH_MODEL_NUMBERS=178509, AC1A, 2ACAHAC01
# MATCH_EXCLUDE_KEYWORDS=ladetajs, charger, tv adapter, edumic, phonak, widex

# --- Example: Monitoring a Nintendo Switch OLED ---
# TARGET_NAME=Nintendo Switch OLED
# SEARCH_TERMS=Nintendo Switch OLED, Switch OLED, Switch konsole
# TARGET_MIN_PRICE=180
# TARGET_MAX_PRICE=320
# MATCH_EXACT_KEYWORDS=Nintendo Switch OLED, Switch OLED
# MATCH_CONTEXT_KEYWORDS=konsole, joy con, dock
# MATCH_MODEL_NUMBERS=HEG-001
# MATCH_EXCLUDE_KEYWORDS=Switch Lite, spēle, game only, case only, vāciņš

# --------------------------------------------------------------
# Telegram Notifications
# --------------------------------------------------------------
# Create a bot via @BotFather and get your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --------------------------------------------------------------
# Optional AI Candidate Classifier (Gemini / OpenAI API)
# --------------------------------------------------------------
# When enabled, borderline candidates (score 40-70) are verified via LLM
LLM_ENABLED=false
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# --------------------------------------------------------------
# Marketplace Sources Configuration
# --------------------------------------------------------------

# SS.com (ss.lv) - Publicly accessible, no credentials needed
SSCOM_ENABLED=true

# Vita Lombards (vitalombards.lv) - Publicly accessible, no credentials needed
VITALOMBARDS_ENABLED=true

# Andele Mandele (andelemandele.lv) - Publicly accessible
ANDELE_ENABLED=true
ANDELE_COOKIES=

# Banknote (veikals.banknote.lv)
BANKNOTE_ENABLED=true
# Optional: browser cookies if Cloudflare bot verification triggers
BANKNOTE_COOKIES=

# Vinted (vinted.lv / vinted.pl)
VINTED_ENABLED=true
# Required for Vinted: Exported browser session cookie (e.g. _vinted_fr_session=...; ...)
# Cloudflare Turnstile blocks unauthenticated HTTP requests to Vinted
VINTED_SESSION_COOKIE=
VINTED_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Facebook Marketplace
# Facebook strictly requires authenticated login sessions
FB_ENABLED=false
FB_COOKIES=

# --------------------------------------------------------------
# Web Dashboard (Public / No login required)
# --------------------------------------------------------------
# View tracked items, scores, signals, and trigger scans at http://localhost:8080
HTTP_ENABLED=true
HTTP_ADDR=:8080

